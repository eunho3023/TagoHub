# 정류장·노선 자료 조각 (pipeline/build_web_data.py 가 만듦): 웹·PC 버전이 어디서든 받게, 1시간 저장
/data/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600

# 웹 버전 화면 (HTML·자바스크립트, site/): 이름이 바뀌지 않는 파일이라 늘 새로 확인 (바뀌지 않았으면 304 로 빨리)
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/app.css
  Cache-Control: no-cache
/js/*
  Cache-Control: no-cache
/config.js
  Cache-Control: no-cache
