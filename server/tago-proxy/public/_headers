# 정류장·노선 자료 조각 (pipeline/build_web_data.py 가 만듦): 웹·PC 버전이 어디서든 받게, 1시간 저장
/data/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600

# 웹 버전 화면: 글꼴·wasm 은 이름이 바뀌지 않거나(글꼴) 빌드마다 새 이름(wasm)이라 오래 저장, 페이지는 늘 새로
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/*.wasm
  Cache-Control: public, max-age=31536000, immutable
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/tagohub.js
  Cache-Control: no-cache
